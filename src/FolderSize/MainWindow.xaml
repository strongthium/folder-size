<Window x:Class="Strongthium.FolderSize.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Strongthium.FolderSize.App"
        Title="Folder Size"
        Width="1320" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <!-- Laid out like Windows' own Settings: the drives down the side, what was found beside them on a layer of its own:
       the totals, then the folders, a treemap, the largest files or the file types. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="256" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Margin="10,6,10,14">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6,0,22">
        <Image x:Name="Logo" Width="30" Height="30" />
        <TextBlock Text="Folder Size" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>

      <!-- Reading a drive's file table needs an administrator. -->
      <Border x:Name="AdminCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" Margin="4,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Scan a drive in seconds" FontWeight="SemiBold" Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,10"
                     Text="As administrator, Folder Size reads an NTFS drive's own file table instead of opening every folder." />
          <Button Click="RunAsAdministrator_Click" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="14" />
              <TextBlock Text="Restart as administrator" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <StackPanel x:Name="AdminNote" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="14,0,4,0">
        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock Style="{StaticResource Caption}" Width="190"
                   Text="Running as administrator: NTFS drives are read from their file table, in seconds." />
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Drives" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="14,0,0,6" />
        <ItemsControl x:Name="Drives">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:Place}">
              <RadioButton Style="{StaticResource PlaceItem}" GroupName="Places" IsChecked="{Binding IsChosen, Mode=TwoWay}" Click="Place_Click">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" VerticalAlignment="Top" Margin="0,2,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource Track}" Height="4" Margin="0,6,0,5">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding UsedFill}" />
                          <ColumnDefinition Width="{Binding UsedRest}" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding FreeText}" Style="{StaticResource Caption}" />
                  </StackPanel>
                </Grid>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource Bare}" Click="ChooseFolder_Click" Margin="0,8,0,0" Padding="14,9" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8DA;" Style="{StaticResource Icon}" FontSize="18" />
            <TextBlock Text="Choose a folder…" Margin="13,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <Grid Margin="36,26,36,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What's scanned, and the buttons for it. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Text="What's taking up the space?" />
            <TextBlock x:Name="PathText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       Text="Pick a drive, or a folder." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0">
            <Button x:Name="UpButton" Click="Up_Click" Margin="0,0,8,0" ToolTip="Scan the folder it's in" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="14" />
                <TextBlock Text="Up" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button x:Name="StopButton" Click="Stop_Click" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="14" />
                <TextBlock Text="Stop" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button x:Name="RescanButton" Click="Rescan_Click" Style="{DynamicResource AccentButtonStyle}" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" />
                <TextBlock Text="Scan again" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- The totals; while scanning, how far it's got. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="24,18">
          <Grid>
            <StackPanel x:Name="Welcome">
              <TextBlock Text="See where your space went" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Click a drive on the left, or choose a folder. Folder Size adds up every folder under it, then shows them largest first, as a treemap, the largest files and the space by file type." />
            </StackPanel>

            <Grid x:Name="Scanning" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel>
                <TextBlock x:Name="ScanElapsed" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Bottom" />
                <TextBlock x:Name="ScanHeading" Style="{StaticResource Heading}" Text="Scanning…" />
              </DockPanel>
              <ProgressBar x:Name="ScanBar" Grid.Row="1" Margin="0,12,0,10" IsIndeterminate="True" />
              <TextBlock x:Name="ScanCurrent" Grid.Row="2" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid x:Name="Totals" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="SizeStat" Style="{StaticResource Stat}" />
                <TextBlock Text="Size" Style="{StaticResource Caption}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource Divider}" />
              <StackPanel Grid.Column="2">
                <TextBlock x:Name="AllocatedStat" Style="{StaticResource Stat}" />
                <TextBlock Text="On disk" Style="{StaticResource Caption}" />
              </StackPanel>
              <Border Grid.Column="3" Style="{StaticResource Divider}" />
              <StackPanel Grid.Column="4">
                <TextBlock x:Name="FilesStat" Style="{StaticResource Stat}" />
                <TextBlock Text="Files" Style="{StaticResource Caption}" />
              </StackPanel>
              <Border Grid.Column="5" Style="{StaticResource Divider}" />
              <StackPanel Grid.Column="6">
                <TextBlock x:Name="FoldersStat" Style="{StaticResource Stat}" />
                <TextBlock Text="Folders" Style="{StaticResource Caption}" />
              </StackPanel>
              <Border Grid.Column="7" Style="{StaticResource Divider}" />
              <StackPanel Grid.Column="8">
                <TextBlock x:Name="TimeStat" Style="{StaticResource Stat}" />
                <TextBlock x:Name="MethodText" Style="{StaticResource Caption}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <StackPanel x:Name="Tabs" Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,8" IsEnabled="False">
          <RadioButton x:Name="FoldersTab" Style="{StaticResource Tab}" Tag="&#xE8B7;" Content="Folders" GroupName="Tabs" IsChecked="True" Checked="Tab_Checked" />
          <RadioButton x:Name="TreemapTab" Style="{StaticResource Tab}" Tag="&#xECA5;" Content="Treemap" GroupName="Tabs" Checked="Tab_Checked" />
          <RadioButton x:Name="LargestTab" Style="{StaticResource Tab}" Tag="&#xE8CB;" Content="Largest files" GroupName="Tabs" Checked="Tab_Checked" />
          <RadioButton x:Name="TypesTab" Style="{StaticResource Tab}" Tag="&#xEB05;" Content="File types" GroupName="Tabs" Checked="Tab_Checked" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,24">
          <Grid>
            <!-- Before the first scan. -->
            <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Image Source="{StaticResource FolderIcon}" Width="64" Height="64" Opacity="0.85" />
              <TextBlock Text="Nothing scanned yet" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,14,0,4" />
              <TextBlock Text="Pick a drive on the left to begin." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>

            <local:FoldersView x:Name="FoldersPage" Visibility="Collapsed" Margin="4" />

            <DockPanel x:Name="TreemapPage" Visibility="Collapsed">
              <DockPanel DockPanel.Dock="Top" Margin="12,10,16,6">
                <Button x:Name="TreemapUp" Style="{StaticResource Bare}" Click="TreemapUp_Click" ToolTip="The folder it's in" Padding="8,6">
                  <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="14" />
                </Button>
                <TextBlock x:Name="TreemapHover" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                <TextBlock x:Name="TreemapPath" VerticalAlignment="Center" Margin="8,0,16,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <local:TreemapView x:Name="Treemap" Margin="12,0,12,12" />
            </DockPanel>

            <local:LargestView x:Name="LargestPage" Visibility="Collapsed" Margin="4" />
            <local:TypesView x:Name="TypesPage" Visibility="Collapsed" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
