<UserControl x:Class="Strongthium.FolderSize.App.LargestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The 1,000 largest files of the scan, wherever they are. -->
  <ListView x:Name="List" BorderThickness="0" Background="Transparent" SelectionMode="Single"
            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
            ContextMenuOpening="List_ContextMenuOpening" MouseDoubleClick="List_MouseDoubleClick">
    <ListView.ItemContainerStyle>
      <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="6,2" />
      </Style>
    </ListView.ItemContainerStyle>
    <ListView.View>
      <GridView AllowsColumnReorder="False">
        <GridViewColumn Width="300" Header="Name">
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Rank}" Style="{StaticResource Muted}" Width="34" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" Margin="12,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="100">
          <GridViewColumn.Header>
            <GridViewColumnHeader HorizontalContentAlignment="Right" Content="Size" />
          </GridViewColumn.Header>
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="150" Header="Share of all">
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Track}" VerticalAlignment="Center">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding ShareFill}" />
                      <ColumnDefinition Width="{Binding ShareRest}" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="3" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                  </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding ShareText}" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
              </Grid>
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="110">
          <GridViewColumn.Header>
            <GridViewColumnHeader HorizontalContentAlignment="Right" Content="Modified" />
          </GridViewColumn.Header>
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ModifiedText}" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
        <GridViewColumn Width="420" Header="Folder">
          <GridViewColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </GridViewColumn.CellTemplate>
        </GridViewColumn>
      </GridView>
    </ListView.View>
  </ListView>
</UserControl>
