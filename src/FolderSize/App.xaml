<Application x:Class="Strongthium.FolderSize.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
  <!-- Windows' own Fluent theme (light or dark, with the Windows accent colour), and the program's styles on top of it.
       Colours come from the theme's brushes, so that both light and dark read well; the only fixed ones are the
       treemap's and the file types' (Palette), and the folder icon's. None of these styles is BasedOn a theme style:
       the theme isn't loaded yet when this is read, so the classic style would be found instead. -->
  <Application.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="VisibleIf" />

      <!-- Text -->
      <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <!-- A number on the summary, with its Caption under it. -->
      <Style x:Key="Stat" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <!-- Surfaces -->
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
      </Style>
      <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="24,4" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
      </Style>

      <!-- The track of a share bar; the share itself is a Border in a Grid inside it, whose two columns are the
           line's ShareFill and ShareRest. -->
      <Style x:Key="Track" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
      </Style>

      <!-- The folder icon, in Windows' own yellow. -->
      <DrawingImage x:Key="FolderIcon">
        <DrawingImage.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="#E3A21A" Geometry="M1,3.5 C1,2.67 1.67,2 2.5,2 L6,2 L7.6,3.6 L13.5,3.6 C14.33,3.6 15,4.27 15,5.1 L15,6 L1,6 Z" />
            <GeometryDrawing Brush="#FFC83D" Geometry="M1,5.4 L15,5.4 L15,12.5 C15,13.33 14.33,14 13.5,14 L2.5,14 C1.67,14 1,13.33 1,12.5 Z" />
          </DrawingGroup>
        </DrawingImage.Drawing>
      </DrawingImage>

      <!-- The places down the side: a drive with how full it is, the chosen one marked like Windows' own navigation. -->
      <Style x:Key="PlaceItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="14,9,12,9">
                <Grid>
                  <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-14,0,0,0"
                          Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                  <ContentPresenter />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- The views over the results: an icon (Tag) and a name, the chosen one underlined in the accent colour. -->
      <Style x:Key="Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid>
                <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="12,8,14,10">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Icon}" FontSize="15" />
                    <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border x:Name="Underline" Height="3" CornerRadius="1.5" Width="18" VerticalAlignment="Bottom"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A button that's only its content (an icon, a heading), shaded under the mouse. -->
      <Style x:Key="Bare" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="4">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
