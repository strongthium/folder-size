<Project Sdk="Microsoft.NET.Sdk">
  <!-- folder-size: shows what takes up the space on a drive or in a folder, as a tree of folders, a treemap, the largest
       files and the space by file type. Windows only, in WPF with Windows' own Fluent theme, so the program itself is
       small: everything it draws with is in the .NET Desktop Runtime. Published as one file for x64 PCs that runs on
       the .NET 10 Desktop Runtime installed on the PC: build.ps1 and .github/workflows/release.yml make it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <AssemblyName>folder-size</AssemblyName>
    <RootNamespace>Strongthium.FolderSize.App</RootNamespace>
    <ApplicationIcon>Assets\folder-size.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main starts the App: it reads the command line first. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- WPF0001: the Fluent theme is experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- The runtime isn't inside it: the .NET 10 Desktop Runtime on the PC runs it. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- A release is the one program: no debug symbols beside it. -->
  <Target Name="LeaveOut" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- WPF leaves System.IO out of the implicit usings (it has a Path of its own, in Shapes). -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\folder-size.png" />
    <Resource Include="Assets\strongthium-banner.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderSize.Core\FolderSize.Core.csproj" />
  </ItemGroup>
</Project>
