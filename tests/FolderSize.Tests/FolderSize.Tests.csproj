<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of FolderSize.Core: the folder scan (on folders it makes in %TEMP%), reading file table records (made
       byte by byte here, since reading a real volume needs administrator rights), the treemap and the sizes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Strongthium.FolderSize.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FolderSize.Core\FolderSize.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
